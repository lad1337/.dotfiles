#!/usr/bin/env bash
#
# Sync the portable "global" section between the live Supacode app config
# (~/.supacode/settings.json, which also holds machine-local repository
# state) and config/supacode/settings.global.json in this repo.
set -euo pipefail

LIVE="$HOME/.supacode/settings.json"
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/config/supacode/settings.global.json"

usage() {
    cat <<EOF
Usage: $(basename "$0") <pull|push> [-f|--force]

  pull          Copy the "global" section from $LIVE into $REPO
  push          Merge the "global" section from $REPO into $LIVE (other keys untouched)
  push --force  Replace the "global" section in $LIVE with $REPO instead of merging
EOF
    exit 1
}

[ $# -ge 1 ] || usage
action="$1"
shift

force=false
while [ $# -gt 0 ]; do
    case "$1" in
        -f|--force) force=true ;;
        *) usage ;;
    esac
    shift
done

case "$action" in
    pull)
        [ -f "$LIVE" ] || { echo "no live settings file at $LIVE" >&2; exit 1; }
        tmp=$(mktemp)
        if [ -f "$REPO" ]; then
            jq --slurpfile g "$LIVE" '. * $g[0].global' "$REPO" > "$tmp" && mv "$tmp" "$REPO"
        else
            jq '.global' "$LIVE" > "$tmp" && mv "$tmp" "$REPO"
        fi
        echo "pulled global settings -> $REPO"
        ;;
    push)
        [ -f "$REPO" ] || { echo "no repo settings file at $REPO" >&2; exit 1; }
        tmp=$(mktemp)
        if [ -f "$LIVE" ]; then
            if [ "$force" = true ]; then
                jq --slurpfile g "$REPO" '.global = $g[0]' "$LIVE" > "$tmp" && mv "$tmp" "$LIVE"
            else
                jq --slurpfile g "$REPO" '.global = ((.global // {}) * $g[0])' "$LIVE" > "$tmp" && mv "$tmp" "$LIVE"
            fi
        else
            mkdir -p "$(dirname "$LIVE")"
            jq -n --slurpfile g "$REPO" '{global: $g[0]}' > "$tmp" && mv "$tmp" "$LIVE"
        fi
        echo "pushed global settings -> $LIVE"
        ;;
    *)
        usage
        ;;
esac
